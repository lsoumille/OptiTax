# Cloudflare Pages Functions Environment Variables (for local development)
# Wrangler 3.x uses .dev.vars for local secrets (NOT .env.local)
# Copy this file to .dev.vars and fill in your values
# NEVER commit .dev.vars to git

GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override default Gemini model (default: gemini-2.0-flash-exp)
# GEMINI_MODEL=gemini-2.0-flash-exp
